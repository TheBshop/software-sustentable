PORT=4000
MONGO_URI=mongodb://localhost:27017/nueva-vida
# En producción: 32+ caracteres aleatorios (Render lo genera solo con render.yaml)
JWT_SECRET=cambiar-por-un-secreto-largo
# URL pública de la web: se usa para armar el link del QR de los certificados
PUBLIC_WEB_URL=http://localhost:5173
# Orígenes web que pueden usar la API, separados por coma. Vacío = cualquiera (solo desarrollo).
CORS_ORIGINS=
# Zona horaria para interpretar fechas sin hora ("2026-11-13")
TZ_OFFSET=-03:00

# Fotos: "local" guarda en UPLOADS_DIR (desarrollo). "s3" usa Cloudflare R2 / AWS S3 (producción).
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Intentos de login fallidos permitidos por IP cada 15 minutos
LOGIN_RATE_LIMIT=10

# Email (opcional). Sin SMTP_HOST los mails se loguean en consola en vez de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cooperativa Nueva Vida <no-reply@example.org>"
