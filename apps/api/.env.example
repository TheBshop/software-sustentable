# Copiar a .env y completar. En producción, todas las variables marcadas como "requerida".

NODE_ENV=production
PORT=4000

# --- requeridas ---
MONGO_URI=mongodb+srv://usuario:password@cluster.xxxx.mongodb.net/gestion-rsu
JWT_SECRET=cambiar-esto-por-32-caracteres-aleatorios-min
PUBLIC_WEB_URL=https://gestionrsu.com.ar
CORS_ORIGINS=https://gestionrsu.com.ar,https://www.gestionrsu.com.ar

# --- storage (Cloudflare R2 o AWS S3) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=gestion-rsu-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=https://files.gestionrsu.com.ar

# --- email (Resend o Brevo SMTP) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=Gestión RSU <no-reply@gestionrsu.com.ar>

# --- rate limits (opcionales; defaults sanos) ---
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=240

# --- observabilidad (opcional) ---
SENTRY_DSN=

# --- IA (opcional, para parsear tickets de combustible desde foto) ---
# Obtener en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- demo mode (SIEMPRE false en producción) ---
DEMO_MODE=false
